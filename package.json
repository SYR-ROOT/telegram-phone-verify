{
  "name": "telegram-phone-verify",
  "version": "0.2.0",
  "description": "Verify a phone number through Telegram instead of SMS. Zero dependencies, framework agnostic.",
  "keywords": [
    "telegram",
    "phone",
    "verification",
    "otp",
    "sms-alternative",
    "bot"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
